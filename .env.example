GOSZAKUP_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CHECK_INTERVAL_SECONDS=300

MIN_HOURS_REMAINING=5
MAX_HOURS_REMAINING=72

APP_TIMEZONE=Asia/Qyzylorda

DATABASE_PATH=data/tenders.db

BOOTSTRAP_LOOKBACK_DAYS=90
SYNC_OVERLAP_MINUTES=10

# Discovery scan is the PRIMARY, authoritative way tenders are found: a full
# re-scan of every keyword with NO lastUpdateDate filter at all. A tender is
# eligible purely by keyword + amount + remaining time -- how long ago
# GosZakup last touched it is never a reason to skip it. Recommended: 60
# (30 if the API handles that safely).
DISCOVERY_SCAN_INTERVAL_MINUTES=60

# A lot must have amount > MIN_AMOUNT_KZT to be sent (exactly the threshold
# does not pass; missing/unparseable amount does not pass).
MIN_AMOUNT_KZT=100000

LOG_LEVEL=INFO
