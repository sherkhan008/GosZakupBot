GOSZAKUP_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CHECK_INTERVAL_SECONDS=300

MIN_HOURS_REMAINING=5
MAX_HOURS_REMAINING=72

APP_TIMEZONE=Asia/Qyzylorda

DATABASE_PATH=data/tenders.db

BOOTSTRAP_LOOKBACK_DAYS=90
SYNC_OVERLAP_MINUTES=10

# Periodic re-scan of ALL keywords (independent of lastUpdateDate), so tenders
# that existed already but only now entered the 5-72h window are not missed.
# Keep this at 1-3 hours (60-180) -- it issues ~keywords*2 requests per run.
DISCOVERY_SCAN_INTERVAL_MINUTES=120
DISCOVERY_LOOKBACK_DAYS=90

# A lot must have amount > MIN_AMOUNT_KZT to be sent (exactly the threshold
# does not pass; missing/unparseable amount does not pass).
MIN_AMOUNT_KZT=100000

LOG_LEVEL=INFO
